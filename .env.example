# Servidor
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
CORS_ENABLED=false
TRUST_PROXY=0

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecos_nicaragua_dev

# Sesiones
SESSION_SECRET=
SESSION_NAME=ecos.sid
SESSION_TTL_HORAS=8
COOKIE_SECURE=false

# Tokens y recuperacion
TOKEN_PEPPER=
RESET_TOKEN_MINUTOS=60

# Multimedia
MEDIA_ROOT=./storage/media
MEDIA_URL=/media

# Correo
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ecos de Nicaragua <no-reply@ejemplo.com>

# Logs y limites
LOG_LEVEL=info
RATE_LIMIT_ENABLED=true
